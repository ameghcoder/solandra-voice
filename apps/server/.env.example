# Gemini API key (server-only, never exposed to browser)
GEMINI_API_KEY=
# Live model name, e.g. gemini-3.8-live (run `pnpm --filter server models` to list available models)
LIVE_MODEL=
# Local dev port, e.g. 8090 (Cloud Run sets PORT automatically)
PORT=

# Solandra API base URL, e.g. https://api.solandra.io
SOLANDRA_API_URL=
# Public chatbot widget keys from the Solandra dashboard (a tab appears only if its key is set)
SOLANDRA_WIDGET_KEY=
SOLANDRA_WIDGET_KEY_CLINIC=
SOLANDRA_WIDGET_KEY_COACHING=
